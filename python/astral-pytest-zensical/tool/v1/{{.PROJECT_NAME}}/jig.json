{
  "version": 1,
  "variables": {
    "PROJECT_NAME": {
      "default": "my-project",
      "prompt": "Project name",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "PYTHON_PACKAGE": {
      "default": "{{ .PROJECT_NAME | replace \"-\" \"_\" }}",
      "prompt": "Name of the python package under src/",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "COMMAND_NAME": {
      "default": "{{ .PROJECT_NAME }}",
      "prompt": "Name of the CLI entrypoint command",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "DESCRIPTION": {
      "default": "A python cli tool",
      "prompt": "A short one-sentence description"
    },
    "AUTHOR": {
      "default": "John Doe",
      "prompt": "The package author, first and last name"
    },
    "EMAIL": {
      "default": "john.doe@example.com",
      "prompt": "The package author email address"
    },
    "LICENSE": {
      "default": "MIT",
      "prompt": "Project license",
      "choices": ["MIT", "Apache-2.0"]
    }
  }
}
